# Web app: React -> WebSocket -> Python -> SQLite.
# uv run --locked --env-file .env python -m server.web
STUDYGROUP_WEB_HOST=127.0.0.1
STUDYGROUP_WEB_PORT=8000
STUDYGROUP_WEB_STATIC_DIR=web/dist
# Omit to allow loopback on WEB_PORT + Vite port 5173.
# For LAN / production set exact public browser origins (comma separated).
# STUDYGROUP_WEB_ORIGINS=https://chat.example.com
# Optional direct HTTPS/WSS. Set both; otherwise terminate TLS at a proxy.
# STUDYGROUP_WEB_TLS_CERT=certs/lan/server.crt
# STUDYGROUP_WEB_TLS_KEY=certs/lan/server.key

# Shared persistent data on the Python server. Never expose this directory.
STUDYGROUP_DATA_DIR=data

# AI summary (CP09), server only. Put the real key only in .env, never in Git.
# Provider: anthropic (default when a key is set), mock (test/demo, labelled), or empty = off.
STUDYGROUP_AI_PROVIDER=
STUDYGROUP_AI_MODEL=claude-haiku-5-5
STUDYGROUP_AI_API_KEY=
STUDYGROUP_AI_TIMEOUT=45
