# Combined local development example. Do not distribute this file with real secrets.
# Load explicitly with: uv run --locked --env-file .env ...
# Config defaults match the values below when variables are absent.
# Relative paths resolve from the project root, not the current working directory.
# Paths also accept absolute paths and ~. Config loading never creates directories.
# Host is a hostname or IP (no URL/port); port must be an integer from 1 to 65535.
# Host/port are shared locally; use separate environments on client/server machines.
STUDYGROUP_HOST=127.0.0.1
STUDYGROUP_PORT=5000

# Server only. Data directory may be new; existing parent must be writable.
# Server certificate and private key must already exist and be readable files.
STUDYGROUP_DATA_DIR=data
STUDYGROUP_TLS_CERT=certs/server.crt
STUDYGROUP_TLS_KEY=certs/server.key

# Client trust configuration: trust this local CA, with hostname checks enabled.
# If absent, defaults to certs/ca.crt (must exist). Set explicitly empty to use
# system CA trust for a publicly trusted server; this never disables verification.
# Do not distribute ca.key or server.key to clients.
STUDYGROUP_TLS_CA=certs/ca.crt

# Server only. Leave unset until an AI provider/model has been selected.
STUDYGROUP_AI_PROVIDER=
STUDYGROUP_AI_MODEL=
STUDYGROUP_AI_API_KEY=
